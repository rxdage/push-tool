# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- 飞书 自定义机器人 ---
FEISHU_WEBHOOK_URL=           # 个人群：行业日报 + 学术周报全文
FEISHU_WEBHOOK_SECRET=        # 若群机器人开启了签名校验，填密钥；否则留空
FEISHU_WEBHOOK_URL_COMPANY=   # 公司群：每天早 8 点学术精选（留空则不启用该任务）
FEISHU_WEBHOOK_SECRET_COMPANY=
DAILY_ACADEMIC_COUNT=5        # 每日学术精选条数

# --- 飞书问答 bot（可选；留空则不启用。docker compose --profile qa up -d qa-bot）---
FEISHU_APP_ID=                # 飞书企业自建应用 App ID
FEISHU_APP_SECRET=            # App Secret
QA_MODEL=claude-haiku-4-5     # 问答模型（便宜）；要更准可换 claude-sonnet-4-6
QA_DAILY_LIMIT_PER_USER=15    # 每人每天提问上限
QA_DAILY_LIMIT_TOTAL=100      # 全群每天提问上限
QA_MONTHLY_BUDGET_USD=5       # 月度预算硬上限（美元），到额停答

# --- 数据库 ---
# docker-compose 内：host 用服务名 db
DATABASE_URL=postgresql+asyncpg://push:push@db:5432/pushtool

# --- 抓取源（可选） ---
S2_API_KEY=                   # Semantic Scholar，可选；留空会 429 被限速（已优雅跳过）。免费申请：https://www.semanticscholar.org/product/api#api-key
PUBMED_EMAIL=                 # PubMed E-utilities 礼貌标识，建议填你的邮箱

# --- 其他 ---
TZ_DEFAULT=Asia/Shanghai
EMBEDDING_MODEL=BAAI/bge-m3   # 本地多语嵌入模型
LOG_LEVEL=INFO
